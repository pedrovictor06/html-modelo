* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    height: 100%;
}

body {
    min-height: 100vh;
}

main {
    height: 80vh;
    background-color: rgb(75, 75, 75);
    color: white;
    padding: 20px;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
}

header, footer {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 10vh;
    background-color: rgb(193, 154, 107);
    color: black;
    padding: 20px;
    gap: 20px;
}

footer {
    flex-direction: column;
    gap: 10px;
}

ul {
    list-style: none;
    display: flex;
    justify-content: center;
    gap: 100px;
}

p {
    width: 400px;
    color: white;
}
